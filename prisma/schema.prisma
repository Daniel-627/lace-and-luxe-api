generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String    @default("")
  image       String?
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
  active      Boolean   @default(true)
  payNow         Boolean @default(true)
  payOnDelivery  Boolean @default(false)
  variants    Variant[]
  media       ProductMedia[]
}

model Variant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique
  size      String
  colour    String
  colourHex String?
  price     Int
  stock     Int     @default(0)

  @@index([productId])
}

model Customer {
  id         Int       @id @default(autoincrement())
  phone      String    @unique
  name       String?
  email      String?
  verifiedAt DateTime
  createdAt  DateTime  @default(now())
  orders     Order[]
  addresses  Address[]
  sessions   Session[]
}

model Address {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  name       String
  phone      String
  county     String
  area       String
  details    String   @default("")
}

model OtpCode {
  id        Int       @id @default(autoincrement())
  phone     String
  codeHash  String
  codeEnc   String?
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
}

model Session {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Order {
  id              Int         @id @default(autoincrement())
  reference       String      @unique
  trackingToken   String      @unique
  customerId      Int?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  contactName     String
  contactPhone    String
  email           String?
  deliveryName    String
  deliveryPhone   String
  county          String
  area            String
  addressDetails  String      @default("")
  total           Int
  status          String      @default("PENDING")
  method          String?
  paystackRef     String?     @unique
  mpesaCheckoutId String?     @unique
  mpesaReceipt    String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())

  fulfilment      String      @default("NEW")
  notes           String      @default("")
  subtotal            Int       @default(0)
  deliveryFee         Int       @default(0)
  deliveryServiceId   Int?
  deliveryServiceName String    @default("")
  discountCode        String?
  discountAmount      Int       @default(0)
  payTiming           String    @default("NOW")
  paymentAccountId    Int?
  paymentClaim        String?
  paymentClaimAt      DateTime?
  payNote             String?
  stockReserved       Boolean   @default(false)
  expiresAt           DateTime?

  @@index([contactPhone])
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  order     Order  @relation(fields: [orderId], references: [id])
  productId Int
  variantId Int
  name      String
  size      String
  colour    String
  price     Int
  qty       Int
}

model Setting {
  key   String @id
  value String
}

model Lead {
  id         Int      @id @default(autoincrement())
  reference  String   @unique
  source     String
  items      Json
  total      Int
  status     String   @default("NEW")
  customerId Int?
  createdAt  DateTime @default(now())
  orderId    Int?
}

model Staff {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  name         String
  passwordHash String
  role         String         @default("STAFF")
  active       Boolean        @default(true)
  mustChangePassword Boolean      @default(false)
  createdAt    DateTime       @default(now())
  sessions     StaffSession[]
}

model StaffSession {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  staffId   Int?
  staffName String
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ProductMedia {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      String
  url       String
  colour    String?
  position  Int     @default(0)

  @@index([productId])
}

model DeliveryService {
  id          Int            @id @default(autoincrement())
  name        String
  description String         @default("")
  etaText     String         @default("")
  active      Boolean        @default(true)
  allowsCod   Boolean        @default(false)
  position    Int            @default(0)
  rates       DeliveryRate[]
}

model DeliveryRate {
  id         Int             @id @default(autoincrement())
  serviceId  Int
  service    DeliveryService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  county     String
  area       String?
  fee        Int
  freeAbove  Int?
  etaText    String?

  @@index([serviceId])
}

model PaymentAccount {
  id            Int     @id @default(autoincrement())
  kind          String
  displayName   String
  number        String
  accountNumber String?
  useOrderRef   Boolean @default(false)
  active        Boolean @default(true)
  position      Int     @default(0)
}

model DiscountCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  description String    @default("")
  kind        String
  value       Int
  minSubtotal Int       @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  maxUses     Int?
  uses        Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}
